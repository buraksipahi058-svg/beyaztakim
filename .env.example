# Bu dosyayı ".env" adıyla kopyalayıp değerleri doldurun.
# .env dosyası git'e gönderilmez; gerçek değerleri yalnızca orada tutun.

# --- Backend ---

# Uzun ve rastgele bir değer. Üretmek için:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=buraya-rastgele-bir-deger-yazin

# Göreli yol backend/ klasörüne göre çözülür (bu örnekte backend/beyaztakim.db).
DATABASE_URL=sqlite:///./beyaztakim.db

# Backend'e istek atabilecek frontend adresleri (virgülle ayrılır)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Seed betiğinin oluşturduğu örnek kullanıcı.
# Parola boş bırakılırsa rastgele üretilir.
SEED_USER_EMAIL=demo@beyaztakim.local
SEED_USER_PASSWORD=

# --- Frontend ---
# Yalnızca VITE_ ile başlayan değişkenler tarayıcıya aktarılır.
VITE_API_URL=http://localhost:8000
